<Window x:Class="Hospital.AdminWindow.AddDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hospital.AdminWindow"
        mc:Ignorable="d" Title="Hospital"
        MinHeight="450" MinWidth="400" Icon="/Hospital;component/Image/MedicalIcon.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" SizeToContent="WidthAndHeight"
        MaxWidth="800" MaxHeight="900">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Добавление врача" FontWeight="Bold" FontSize="16" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
        
        <Label Content="Фамилия:" Grid.Row="1"/>
        <TextBox x:Name="LastNameTextBox" Grid.Row="2" Margin="0,0,0,10"/>

        <Label Content="Имя:" Grid.Row="3"/>
        <TextBox x:Name="FirstNameTextBox" Grid.Row="4" Margin="0,0,0,10"/>

        <Label Content="Отчество:" Grid.Row="5"/>
        <TextBox x:Name="MiddleNameTextBox" Grid.Row="6" Margin="0,0,0,10"/>

        <Label Content="Специализация:" Grid.Row="7"/>
        <ComboBox x:Name="SpecializationComboBox" Grid.Row="8" Margin="0,0,0,10" IsEditable="True" Text="{Binding SelectedSpecialization}"/>

        <Label Content="Внутренний телефон:" Grid.Row="9"/>
        <TextBox x:Name="PhoneTextBox" Grid.Row="10" Margin="0,0,0,10" PreviewTextInput="PhoneTextBox_PreviewTextInput"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Margin="5" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>