<Window x:Class="Hospital.AdminWindow.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hospital.AdminWindow"
        mc:Ignorable="d"
        MinHeight="440" MinWidth="400" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Title="Hospital" Icon="/Hospital;component/Image/MedicalIcon.ico" SizeToContent="WidthAndHeight"
        MaxWidth="800" MaxHeight="900">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Добавление пользователя" FontWeight="Bold" FontSize="16" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>

        <Label Content="Логин:" Grid.Row="1"/>
        <TextBox x:Name="LoginTextBox" Grid.Row="2" Margin="0,0,0,10"/>

        <Label Content="Пароль:" Grid.Row="3"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Margin="0,0,0,10" PasswordChanged="PasswordBox_PasswordChanged"/>

        <Label Content="Повторите пароль:" Grid.Row="3" Grid.Column="1"/>
        <PasswordBox x:Name="RepeatPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" PasswordChanged="RepeatPasswordBox_PasswordChanged"/>
        <TextBlock x:Name="PasswordMatchText" Grid.Row="5" Grid.Column="1" Foreground="Red" Margin="0,0,0,5"/>

        <CheckBox x:Name="IsDoctorCheckBox" Grid.Row="6" Content="Это врач" Margin="0,10,0,10"/>

        <Label Content="Выберите врача:" Grid.Row="7" x:Name="DoctorLabel" Visibility="Collapsed"/>
        <ComboBox x:Name="DoctorComboBox" Grid.Row="8" Margin="0,0,0,10" Visibility="Collapsed"/>

        <Label Content="Фамилия:" Grid.Row="9" x:Name="LastNameLabel"/>
        <TextBox x:Name="LastNameTextBox" Grid.Row="10" Margin="0,0,0,10"/>

        <Label Content="Имя:" Grid.Row="9" Grid.Column="1" x:Name="FirstNameLabel"/>
        <TextBox x:Name="FirstNameTextBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,10"/>

        <Label Content="Отчество:" Grid.Row="11" x:Name="MiddleNameLabel"/>
        <TextBox x:Name="MiddleNameTextBox" Grid.Row="12" Margin="0,0,0,10"/>

        <Label Content="Роль:" Grid.Row="11" Grid.Column="1" x:Name="RoleLabel"/>
        <ComboBox x:Name="RoleComboBox" Grid.Row="12" Grid.Column="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" Margin="5" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>