<Window x:Class="Hospital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hospital"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Hospital" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Height="370" Width="350"
        
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI"
        Icon="Image/MedicalIcon.ico">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignPasswordBox}">
            <Setter Property="Margin" Value="0,5,0,20"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Логотип и заголовок -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
            <materialDesign:PackIcon Kind="Hospital" Width="50" Height="50"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Hospital" 
                      FontSize="18" FontWeight="SemiBold"
                      HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Вход в систему" 
                      FontSize="16" Foreground="#666666"
                      HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Поле логина -->
        <TextBox Grid.Row="1" Text="Reg"
                 materialDesign:HintAssist.Hint="Логин"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 x:Name="LoginTB"
                 FontSize="14"/>

        <!-- Поле пароля -->
        <PasswordBox Grid.Row="2" Password="Reg1"
                     materialDesign:HintAssist.Hint="Пароль"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                     x:Name="PasswordBx"/>

        <!-- Кнопка входа -->
        <Button Grid.Row="3" 
                Content="Войти"              
                Padding="15,8"
                HorizontalAlignment="Stretch"
                Margin="0,15,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Background="{DynamicResource PrimaryHueMidBrush}"
                Foreground="Black"
                BorderThickness="0"
                x:Name="Vxod" 
                Click="Vxod_Click">
            <Button.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
            </Button.Effect>
        </Button>

        <!-- Ссылка на восстановление пароля -->
        <!--<TextBlock Grid.Row="4" 
                   Text="Забыли пароль?" 
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                   FontSize="12"
                   Cursor="Hand">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="TextDecorations" Value="None"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>-->
    </Grid>
</Window>
