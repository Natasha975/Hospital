<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="МедДосье.ProfilePage">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20">

                <Label Text="Регистрация" FontSize="24" TextColor="Black" HorizontalOptions="Center" Margin="0,0,0,20"/>

                <Label Text="Фамилия*" TextColor="Gray" Margin="0,10,0,0"/>
                <Grid>
                    <BoxView BackgroundColor="#F0F0F0" CornerRadius="5" />
                    <Entry x:Name="LastNameEntry" Placeholder="Фамилия" TextColor="Black" BackgroundColor="Transparent" />
                </Grid>

                <Label Text="Имя*" TextColor="Gray" Margin="0,10,0,0"/>
                <Grid>
                    <BoxView BackgroundColor="#F0F0F0" CornerRadius="5" />
                    <Entry x:Name="FirstNameEntry" Placeholder="Имя" TextColor="Black" BackgroundColor="Transparent" />
                </Grid>

                <Label Text="Отчество" TextColor="Gray" Margin="0,10,0,0"/>
                <Grid>
                    <BoxView BackgroundColor="#F0F0F0" CornerRadius="5" />
                    <Entry x:Name="MiddleNameEntry" Placeholder="Отчество" TextColor="Black" BackgroundColor="Transparent" />
                </Grid>

                <Label Text="Дата рождения" TextColor="Gray" Margin="0,10,0,0"/>
                <DatePicker x:Name="BirthDatePicker" TextColor="Black" BackgroundColor="#F0F0F0" HorizontalOptions="FillAndExpand"/>

                <Label Text="Электронная почта*" TextColor="Gray" Margin="0,10,0,0"/>
                <Grid>
                    <BoxView BackgroundColor="#F0F0F0" CornerRadius="5" />
                    <Entry x:Name="EmailEntry" Placeholder="Электронная почта" TextColor="Black" BackgroundColor="Transparent" />
                </Grid>

                <Label Text="Пароль*" TextColor="Gray" Margin="0,10,0,0"/>
                <Grid>
                    <BoxView BackgroundColor="#F0F0F0" CornerRadius="5" />
                    <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" TextColor="Black" BackgroundColor="Transparent" />
                </Grid>

                <Label Text="Пол" TextColor="Gray" Margin="0,10,0,0"/>
                <StackLayout Orientation="Horizontal">
                    <RadioButton x:Name="MaleRadioButton" Content="Мужской" TextColor="Black" />
                    <RadioButton Content="Женский" TextColor="Black" />
                </StackLayout>

                <Button Text="Завершить регистрацию" BackgroundColor="Brown" TextColor="White" CornerRadius="25" Margin="0,20,0,0" 
                        x:Name="Next" Clicked="Next_Clicked"/>

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>